# Git Aliases
alias gs="git status"
alias ga="git add -A && git status"
alias gc="git commit -m"
alias gp="git push"
alias gpm="git pull origin main"
alias gst="git stash"
alias gsp="git stash pop"
alias gcls="git add -A && git stash && git stash drop stash@{0}"
alias gco="git checkout"

# CLI Aliases
alias ll="ls -la"
alias c="clear"
alias .="cd .."

# Vim Aliases
alias v="nvim ."
alias vi="nvim ."
alias vim="nvim ."
